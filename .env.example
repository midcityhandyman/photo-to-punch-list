# Only needed for --client claude. The mock client, the tests and the demo need no keys.
ANTHROPIC_API_KEY=

# Vision model id. Any Claude model with image input works.
PUNCHLIST_MODEL=claude-sonnet-5-5

# Effort level sent as output_config.effort: low | medium | high
PUNCHLIST_EFFORT=medium

# Findings below this confidence are flagged "needs review" in the output.
PUNCHLIST_REVIEW_THRESHOLD=0.6
